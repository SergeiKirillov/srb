<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#EAF2FA">

    <TextView
        android:id="@+id/widget_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Сменный справочник"
        android:textColor="#183153"
        android:textSize="16sp"
        android:textStyle="bold" />
    
    <TextView
        android:id="@+id/widget_night"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Ночная смена: бригада № 2"
        android:textColor="#183153"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/widget_day"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Дневная смена: бригада № 4"
        android:textColor="#183153"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Нажмите, чтобы открыть текущую бригаду"
        android:textColor="#526579"
        android:textSize="12sp" />

</LinearLayout>

